# Copy to deploy/local.env (git-ignored) for scripts/site.sh deploy.
# SSH host that serves the page (an alias from ~/.ssh/config).
PUBLISH_HOST=my-server
# Folder the web server serves at /tidewatch/ (synced with --delete).
PUBLISH_SITE_ROOT=/var/www/tidewatch
# Folder with Tidewatch-<version>.dmg files and the Tidewatch.dmg symlink, served at /tidewatch/download/.
PUBLISH_DOWNLOADS=/var/www/tidewatch-downloads
# Live page URLs to check after a deploy, space separated, no trailing slash.
PUBLISH_URLS="https://example.com/tidewatch"
